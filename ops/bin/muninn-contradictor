#!/usr/bin/env python3
"""
muninn-contradictor — LLM contradiction-detection worker across MuninnDB vaults.

Sibling of muninn-promoter/muninn-enricher, sharing their config file, LM
Studio wrapper, sqlite-queue pattern, and thinking-off guard.

Nothing currently produces `contradicts` links: MCP writes carry no
associations, and the server's structural detector only sees single-write
associations. The server's built-in enrich plugin is deliberately
unconfigured (deferred-enrichment architecture). This worker is the missing
producer: it sweeps every reachable vault, finds candidate partner engrams
for each target (shared entities, semantic similarity), asks an LLM whether
any candidate DIRECTLY factually contradicts the target, and — only under
--run — writes a `contradicts` link via POST /api/link.

Design:
  - Durable sqlite queue: `sweep` (per-vault engram coverage, oldest-first
    processing, content-hash based requeue-on-change) + `pairs` (judged pair
    cache, keyed on sorted (vault,id_a,id_b), never re-judged once resolved).
  - Candidate generation per target: shared entities (local join against the
    sweep cache — no REST route exists for this), semantic (POST /api/activate),
    lexical (skipped — no FTS/search REST route exists on this fork).
  - Cross-vault pairs are out of scope: contradiction links are engram-ID
    links, single-vault only (same constraint noted in the project-vaults
    plan). agent-memory<->project duplicates are expected (dual-write design),
    not contradictions.
  - Resolution respect: POST /api/admin/contradictions/resolve DELETES the
    storage marker outright (see internal/storage/association.go), so a
    resolved pair is indistinguishable from "never linked" via
    GET /api/contradictions. Our scoped key cannot reach the admin resolve
    endpoint anyway. We track linked pairs permanently in local sqlite and
    never re-link a pair once verdict='linked', regardless of what the
    server's contradictions list shows later.
  - --dry-run judges and caches verdicts locally (verdict='flagged') but
    performs zero writes. --run first flushes any previously-flagged pairs
    (from an earlier --dry-run) via POST /api/link, then continues sweeping:
    freshly-judged contradictions are written immediately rather than staged.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import sqlite3
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CONFIG_PATH = HOME / ".config" / "muninn-enricher.json"  # shared config
STATE_DIR = HOME / ".local" / "share" / "muninn-contradictor"
DB_PATH = STATE_DIR / "queue.db"
LOG_PATH = STATE_DIR / "contradictor.log"

REL_CONTRADICTS = 2  # storage.RelContradicts (0x0002)

DEFAULT_CONTRADICTOR_CFG = {
    "sweep_batch": 0,  # 0 = unlimited: --run sweeps the entire unswept backlog to completion
    "partners_max": 24,
    "partners_semantic": 12,
    "model": "standard",
    "reasoning": "off",
    "max_retries": 3,
    "pace_ms": 150,
    "discovery_page_size": 200,
    "discovery_max_pages_per_vault": 0,  # 0 = unlimited: discover the whole vault in one run (optional cap for testing)
    "recheck_quota_per_vault": 5,
}


# ─── Config + logging ──────────────────────────────────────────────────────

def load_config() -> dict:
    try:
        return json.loads(CONFIG_PATH.read_text())
    except Exception as e:
        log(f"config load failed: {e}; defaults")
        return {}


def contradictor_cfg(cfg: dict) -> dict:
    merged = dict(DEFAULT_CONTRADICTOR_CFG)
    merged.update(cfg.get("contradictor", {}))
    return merged


def log(msg: str) -> None:
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        ts = datetime.now().isoformat()
        with open(LOG_PATH, "a") as f:
            f.write(f"{ts} {msg}\n")
        if os.environ.get("MUNINN_CONTRADICTOR_VERBOSE"):
            print(f"[{ts}] {msg}", file=sys.stderr)
    except Exception:
        pass


# ─── LM Studio model manager (mirrors muninn-enricher / muninn-promoter) ───

class LMStudio:
    """Wraps LM Studio's native v1 REST API for model management + chat."""

    def __init__(self, cfg: dict):
        self.base = cfg.get("base_url", "http://127.0.0.1:1234")
        self.key = cfg["key"]
        self.timeout = cfg.get("timeout_sec", 180)

    def _req(self, path: str, body: dict | None = None, method: str = "GET", timeout: int | None = None) -> dict | None:
        url = self.base + path
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method, headers={
            "Authorization": f"Bearer {self.key}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        })
        try:
            with urllib.request.urlopen(req, timeout=timeout or self.timeout) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            try:
                err_body = e.read()[:300].decode(errors="replace")
            except Exception:
                err_body = ""
            log(f"LM Studio {method} {path} HTTP {e.code}: {err_body}")
            return {"_http_error": e.code, "_body": err_body}
        except Exception as e:
            log(f"LM Studio {method} {path} failed: {e}")
            return None

    def list_models(self) -> list[dict]:
        res = self._req("/api/v1/models", timeout=15)
        if not res or "_http_error" in res:
            return []
        return res.get("models", []) or []

    def loaded(self) -> list[dict]:
        out = []
        for m in self.list_models():
            for inst in m.get("loaded_instances", []) or []:
                out.append({
                    "key": m.get("key", ""),
                    "instance_id": inst.get("id") or m.get("key", ""),
                    "context_length": inst.get("config", {}).get("context_length"),
                    "reasoning_default": (m.get("capabilities", {}) or {}).get("reasoning", {}).get("default"),
                })
        return out

    def model_ready(self, model_id: str) -> tuple[bool, str]:
        try:
            req = urllib.request.Request(
                self.base + "/api/v1/models",
                headers={"Authorization": f"Bearer {self.key}", "Accept": "application/json"},
                method="GET")
            with urllib.request.urlopen(req, timeout=10) as r:
                d = json.loads(r.read())
        except Exception as e:
            return False, f"LM Studio unreachable: {e}"
        loaded = [m.get("key") for m in d.get("models", []) if m.get("loaded_instances")]
        if model_id in loaded:
            return True, "ready"
        return False, f"model {model_id} not loaded (have: {loaded or 'nothing'}); pausing until reloaded"

    def probe_thinking_off(self, model_id: str) -> tuple[bool, int]:
        """Cheap assertion (see muninn-enricher for full rationale)."""
        parsed, reasoning = self.chat_extract(
            model_id, 200, 'Output exactly: {"x":1}', "ping",
            temperature=0, reasoning="off")
        if reasoning < 0:
            return False, -1
        return reasoning == 0, reasoning

    def chat_extract(self, model_id: str, max_tokens: int, system: str, user: str,
                      temperature: float = 0.0, reasoning: str = "off") -> tuple[dict | None, int]:
        """Native /api/v1/chat call. `reasoning` is per-request and overrides
        the GUI toggle entirely."""
        payload = {
            "model": model_id, "temperature": temperature, "max_output_tokens": max_tokens,
            "input": user, "system_prompt": system, "reasoning": reasoning,
        }
        res = self._req("/api/v1/chat", body=payload, method="POST", timeout=self.timeout)
        if not res or "_http_error" in res:
            return None, -1
        if "error" in res:
            log(f"  LM Studio chat error: {res['error'].get('message','')[:150]}")
            return None, -1
        content = None
        for item in res.get("output", []) or []:
            if item.get("type") != "message":
                continue
            c = item.get("content")
            if isinstance(c, str):
                content = c
            elif isinstance(c, list):
                parts = [p.get("content", p.get("text", "")) for p in c if isinstance(p, dict)]
                content = "".join(str(p) for p in parts)
        if content is None:
            return None, -1
        content = content.strip()
        reasoning_tokens = res.get("stats", {}).get("reasoning_output_tokens")
        if reasoning_tokens is None:
            reasoning_tokens = sum(
                len(item.get("content", "")) for item in res.get("output", []) or []
                if item.get("type") == "reasoning")
        if content.startswith("```"):
            content = content.split("\n", 1)[1].rsplit("```", 1)[0].strip()
        if not content.startswith("{"):
            i, j = content.find("{"), content.rfind("}")
            if i >= 0 and j > i:
                content = content[i:j + 1]
        try:
            return json.loads(content), reasoning_tokens
        except Exception as e:
            log(f"  JSON parse failed: {e}; raw[:120]={content[:120]!r}")
            return None, reasoning_tokens

    def reasoning_allowed_options(self, model_id: str) -> list[str]:
        for m in self.list_models():
            if m.get("key") == model_id:
                return ((m.get("capabilities", {}) or {}).get("reasoning", {}) or {}).get("allowed_options", []) or []
        return []


# ─── DB (durable queue) ─────────────────────────────────────────────────────

SCHEMA = """
CREATE TABLE IF NOT EXISTS sweep (
    vault TEXT,
    id TEXT,
    created_at REAL,
    concept TEXT,
    summary TEXT,
    content TEXT,
    entities TEXT,
    content_hash TEXT,
    discovered_at REAL,
    swept_at REAL,
    PRIMARY KEY (vault, id)
);
CREATE INDEX IF NOT EXISTS idx_sweep_vault_swept ON sweep(vault, swept_at);
CREATE INDEX IF NOT EXISTS idx_sweep_vault_created ON sweep(vault, created_at);

CREATE TABLE IF NOT EXISTS discovery_cursor (
    vault TEXT PRIMARY KEY,
    backlog_offset INTEGER DEFAULT 0,
    backlog_done INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS pairs (
    pair_key TEXT PRIMARY KEY,
    vault TEXT,
    id_a TEXT,
    id_b TEXT,
    verdict TEXT,      -- 'flagged' | 'linked' | 'rejected'
    reason TEXT,
    checked_at REAL,
    linked_at REAL
);
CREATE INDEX IF NOT EXISTS idx_pairs_vault_verdict ON pairs(vault, verdict);
"""


def db_connect() -> sqlite3.Connection:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    conn.commit()
    return conn


def pair_key(vault: str, id_a: str, id_b: str) -> str:
    a, b = sorted([id_a, id_b])
    return hashlib.sha256(f"{vault}|{a}|{b}".encode()).hexdigest()[:24]


def content_hash(concept: str, content: str) -> str:
    return hashlib.sha256(f"{concept}\n{content}".encode()).hexdigest()[:16]


# ─── REST client ────────────────────────────────────────────────────────────

class RestClient:
    """Concurrency is intentionally 1: shares the server's per-IP rate
    limiter with the enricher's polling loop. `_retrying` backs off on 429
    (honouring Retry-After when present)."""

    def __init__(self, endpoint: str, api_key: str, pace_ms: int = 150):
        self.endpoint = endpoint.rstrip("/")
        self.api_key = api_key
        self.pace_s = max(0, pace_ms) / 1000.0

    def _retrying(self, do_request, label: str, max_attempts: int = 6):
        delay = 0.5
        for attempt in range(1, max_attempts + 1):
            try:
                res = do_request()
                if self.pace_s:
                    time.sleep(self.pace_s)
                return res
            except urllib.error.HTTPError as e:
                if e.code == 429 and attempt < max_attempts:
                    retry_after = e.headers.get("Retry-After") if e.headers else None
                    wait = float(retry_after) if retry_after else delay
                    log(f"{label}: 429, backing off {wait:.1f}s (attempt {attempt}/{max_attempts})")
                    time.sleep(wait)
                    delay = min(delay * 2, 10.0)
                    continue
                log(f"{label} failed: HTTP {e.code}")
                return None
            except Exception as e:
                log(f"{label} failed: {e}")
                return None
        return None

    def _get(self, path: str, timeout: int = 15) -> dict | list | None:
        def do():
            req = urllib.request.Request(
                f"{self.endpoint}{path}",
                headers={"Authorization": f"Bearer {self.api_key}", "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read())
        return self._retrying(do, f"GET {path}")

    def _post(self, path: str, body: dict, timeout: int = 20) -> dict | None:
        def do():
            data = json.dumps(body).encode()
            req = urllib.request.Request(
                f"{self.endpoint}{path}", data=data, method="POST",
                headers={"Authorization": f"Bearer {self.api_key}", "Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read())
        return self._retrying(do, f"POST {path}")

    def discover_vaults(self) -> list[str]:
        """GET /api/vaults is scope-filtered server-side on this fork — it
        returns exactly the vaults this key can reach (agent-memory + proj-*)."""
        all_vaults = self._get("/api/vaults")
        if not isinstance(all_vaults, list):
            log("GET /api/vaults failed or returned non-list; no vaults discovered")
            return []
        return sorted(all_vaults)

    def list_engrams_page(self, vault: str, limit: int, offset: int) -> dict | None:
        q = urllib.parse.urlencode({"vault": vault, "limit": limit, "offset": offset, "sort": "created"})
        return self._get(f"/api/engrams?{q}")

    def get_engram(self, vault: str, engram_id: str) -> dict | None:
        q = urllib.parse.urlencode({"vault": vault})
        return self._get(f"/api/engrams/{engram_id}?{q}")

    def activate(self, vault: str, context: list[str], max_results: int = 12) -> dict | None:
        # The auth middleware resolves the request vault from the query
        # string even for POST bodies — a body-only "vault" that doesn't
        # match the query-resolved vault is rejected with 400 (code 4003).
        q = urllib.parse.urlencode({"vault": vault})
        return self._post(f"/api/activate?{q}", {
            "vault": vault, "context": context, "max_results": max_results, "disable_hops": True,
        })

    def contradictions(self, vault: str) -> dict | None:
        q = urllib.parse.urlencode({"vault": vault})
        return self._get(f"/api/contradictions?{q}")

    def link(self, vault: str, source_id: str, target_id: str, rel_type: int = REL_CONTRADICTS,
              weight: float = 1.0) -> dict | None:
        q = urllib.parse.urlencode({"vault": vault})
        return self._post(f"/api/link?{q}", {
            "vault": vault, "source_id": source_id, "target_id": target_id,
            "rel_type": rel_type, "weight": weight,
        })


# ─── created_at normalisation (mirrors muninn-promoter) ────────────────────

def normalise_ts(raw) -> float:
    raw = raw or 0
    if raw > 1e17:
        return raw / 1e9   # ns (GET-by-id)
    if raw > 1e14:
        return raw / 1e6   # us
    if raw > 1e11:
        return raw / 1e3   # ms
    return float(raw)      # s (list endpoint)


# ─── Discovery (sweep-table population) ────────────────────────────────────

def discover_vault(rest: RestClient, conn: sqlite3.Connection, vault: str,
                    page_size: int, max_pages: int) -> int:
    """Two-phase discovery. `max_pages<=0` means unlimited — the default is
    now to fully discover a vault (however large) in one run, same as the
    sweep/judge phase; `max_pages>0` remains available as an optional cap
    for testing.

    Phase 1 (delta scan) — walk the list endpoint newest-first from offset 0,
    inserting unknown ids, stopping as soon as a known id is hit (small,
    fixed page cap regardless of `max_pages` — it only exists to catch
    writes since the last run cheaply, not to bound total coverage).

    Phase 2 (backlog scan) — resumes from a persisted per-vault cursor
    (`discovery_cursor`) so a capped/interrupted run picks up exactly where
    it left off next time instead of re-scanning or silently truncating
    coverage. Marked `backlog_done` once it reaches `total`. New engrams
    inserted between runs shift list offsets slightly, so the backlog scan
    can re-see a few ids near its cursor (harmless — INSERT OR IGNORE) but
    phase 1 independently guarantees new arrivals at the front are never
    missed."""
    now = time.time()
    added = 0
    pages = 0
    unlimited = max_pages <= 0

    def insert_new(items) -> tuple[int, bool]:
        n, saw_known = 0, False
        for item in items:
            eid = item.get("id")
            if not eid:
                continue
            row = conn.execute("SELECT 1 FROM sweep WHERE vault=? AND id=?", (vault, eid)).fetchone()
            if row:
                saw_known = True
                continue
            conn.execute(
                "INSERT OR IGNORE INTO sweep (vault, id, created_at, discovered_at) VALUES (?,?,?,?)",
                (vault, eid, normalise_ts(item.get("created_at")), now))
            n += 1
        return n, saw_known

    # Phase 1: delta scan — always a small fixed cap, independent of max_pages.
    delta_cap = 5
    offset = 0
    while pages < delta_cap:
        page = rest.list_engrams_page(vault, page_size, offset)
        pages += 1
        if not page or not isinstance(page, dict):
            break
        items = page.get("engrams", []) or []
        if not items:
            break
        n, hit_known = insert_new(items)
        added += n
        conn.commit()
        total = int(page.get("total") or 0)
        offset += len(items)
        if hit_known or offset >= total:
            break

    # Phase 2: backlog scan (persisted cursor)
    cur = conn.execute("SELECT backlog_offset, backlog_done FROM discovery_cursor WHERE vault=?", (vault,)).fetchone()
    if not cur:
        conn.execute("INSERT INTO discovery_cursor (vault, backlog_offset, backlog_done) VALUES (?,0,0)", (vault,))
        conn.commit()
        backlog_offset, backlog_done = 0, 0
    else:
        backlog_offset, backlog_done = cur["backlog_offset"], cur["backlog_done"]

    if not backlog_done:
        offset = backlog_offset
        while unlimited or pages < max_pages:
            page = rest.list_engrams_page(vault, page_size, offset)
            pages += 1
            if not page or not isinstance(page, dict):
                break
            items = page.get("engrams", []) or []
            if not items:
                backlog_done = 1
                break
            n, _ = insert_new(items)
            added += n
            conn.commit()
            total = int(page.get("total") or 0)
            offset += len(items)
            if offset >= total:
                backlog_done = 1
                break
        conn.execute("UPDATE discovery_cursor SET backlog_offset=?, backlog_done=? WHERE vault=?",
                     (offset, backlog_done, vault))
        conn.commit()

    return added


# ─── Target selection ───────────────────────────────────────────────────────
#
# Two independently-bounded selectors. The main sweep loop drains
# `select_unswept_chunk` for every vault to exhaustion (that's "done"); a
# separate, small, quota-bounded pass over `select_recheck_chunk` runs
# afterwards to notice content changes. Keeping them separate means the main
# loop has a real end (all unswept rows judged) instead of an unbounded
# recheck rotation that would never terminate on its own.

def select_unswept_chunk(conn: sqlite3.Connection, vault: str, want: int) -> list[str]:
    return [r["id"] for r in conn.execute(
        "SELECT id FROM sweep WHERE vault=? AND swept_at IS NULL ORDER BY created_at ASC LIMIT ?",
        (vault, want))]


def select_recheck_chunk(conn: sqlite3.Connection, vault: str, want: int) -> list[str]:
    return [r["id"] for r in conn.execute(
        "SELECT id FROM sweep WHERE vault=? AND swept_at IS NOT NULL ORDER BY swept_at ASC LIMIT ?",
        (vault, want))]


# ─── Candidate generation ───────────────────────────────────────────────────

def gen_candidates(rest: RestClient, conn: sqlite3.Connection, vault: str, target: dict,
                    partners_max: int, partners_semantic: int) -> tuple[list[dict], dict]:
    """Returns (candidates, diag) where diag records which modalities ran."""
    target_id = target["id"]
    candidates: dict[str, dict] = {}
    diag = {"entity_hits": 0, "semantic_hits": 0, "lexical": "skipped (no FTS/search REST route on this fork)"}

    target_entities = {e.get("name", "").strip().lower() for e in (target.get("entities") or []) if e.get("name")}
    if target_entities:
        rows = conn.execute(
            "SELECT id, concept, summary, content, entities FROM sweep "
            "WHERE vault=? AND id!=? AND entities IS NOT NULL AND entities != '[]'",
            (vault, target_id))
        for row in rows:
            try:
                ents = {e.get("name", "").strip().lower() for e in json.loads(row["entities"] or "[]") if e.get("name")}
            except Exception:
                continue
            if ents & target_entities:
                candidates[row["id"]] = {
                    "id": row["id"], "concept": row["concept"] or "",
                    "summary": row["summary"] or "", "content": row["content"] or "",
                }
                diag["entity_hits"] += 1

    query_text = (target.get("content") or target.get("concept") or "")[:1500]
    if query_text.strip():
        act = rest.activate(vault, [query_text], max_results=partners_semantic)
        if act:
            for item in act.get("activations", act.get("results", [])) or []:
                iid = item.get("id")
                if not iid or iid == target_id or iid in candidates:
                    continue
                candidates[iid] = {
                    "id": iid, "concept": item.get("concept", ""),
                    "summary": item.get("summary", ""), "content": item.get("content", ""),
                }
                diag["semantic_hits"] += 1

    out = list(candidates.values())[:partners_max]
    return out, diag


# ─── LLM judging ─────────────────────────────────────────────────────────────

SYS_PROMPT_CONTRADICT = (
    'You find DIRECT factual contradictions between a target memory and a list of '
    'candidate memories from the same vault. A contradiction means the two statements '
    'CANNOT both be true: conflicting values, versions, paths, configurations, or '
    'decisions about the SAME subject.\n'
    'Do NOT flag:\n'
    '  - differences of topic (about different subjects entirely)\n'
    '  - opinion evolution over time (a preference that was later revised is not a '
    'contradiction, it is an update)\n'
    '  - conversational evolution: a mid-thread correction ("its not X, it is Y"), an '
    'instruction that was later amended, or in-progress status that changed as work '
    'proceeded — these are one thread updating itself, not two independent facts, not '
    'two independent claims\n'
    '  - raw tool output, task notifications, logs, environment-context snapshots, or '
    'status blobs stored as memories — surface-level metric mismatches between such '
    'fragments are not factual contradictions\n'
    '  - mutable runtime state observed at different times (a service running vs '
    'stopped, a model loaded vs unloaded, the current working directory, a job\'s '
    'progress) — state changes over time; these are snapshots, not conflicting claims. '
    'Durable configuration/decision claims (a port number, a chosen architecture, a '
    'documented convention) DO still conflict if they disagree.\n'
    '  - differences of tone, phrasing, or level of detail\n'
    '  - one memory being more specific/detailed than another without conflicting\n'
    'Flag ONLY pairs of independently-stored factual claims that cannot both be true.\n'
    'Output ONLY valid JSON, no prose, no markdown fences:\n'
    '{"contradictions": [{"index": <candidate number>, "reason": "<one sentence>"}]}\n'
    'If none of the candidates contradict the target, output {"contradictions": []}.'
)


def truncate(s: str, n: int) -> str:
    s = (s or "").strip()
    return s if len(s) <= n else s[:n] + "…"


def judge_batch(lm: LMStudio, model_id: str, max_tokens: int, reasoning_mode: str,
                 target: dict, batch: list[dict]) -> list[dict] | None:
    user_lines = [
        f"TARGET:\nConcept: {target.get('concept','')}\n"
        f"Summary: {truncate(target.get('summary',''), 300)}\n"
        f"Content: {truncate(target.get('content',''), 1500)}\n\nCANDIDATES:"
    ]
    for i, c in enumerate(batch, start=1):
        user_lines.append(
            f"[{i}] Concept: {c.get('concept','')}\n"
            f"    Summary: {truncate(c.get('summary','') or c.get('content',''), 300)}"
        )
    user = "\n".join(user_lines)
    parsed, reasoning = lm.chat_extract(model_id, max_tokens, SYS_PROMPT_CONTRADICT, user,
                                         temperature=0.0, reasoning=reasoning_mode)
    if reasoning_mode == "off" and reasoning > 0:
        log(f"  ⚠ judge used {reasoning} reasoning tokens despite reasoning=off")
    if parsed is None:
        return None
    out = []
    for item in parsed.get("contradictions", []) or []:
        try:
            idx = int(item.get("index"))
        except Exception:
            continue
        if 1 <= idx <= len(batch):
            out.append({"candidate": batch[idx - 1], "reason": (item.get("reason") or "").strip()})
    return out


# ─── Pipeline ────────────────────────────────────────────────────────────────

def seed_pairs_from_server(rest: RestClient, conn: sqlite3.Connection, vaults: list[str]) -> int:
    """Startup pass: any pair the server currently reports as contradicting
    is recorded verdict='linked' if not already known, so it is never
    re-judged or re-linked (idempotent — a pair the server itself resolved
    away and this worker never linked will simply not appear here, which is
    fine: we only need to avoid re-linking pairs WE created or that already
    exist)."""
    seeded = 0
    for vault in vaults:
        resp = rest.contradictions(vault)
        if not resp:
            continue
        for item in resp.get("contradictions", []) or []:
            ida, idb = item.get("id_a"), item.get("id_b")
            if not ida or not idb:
                continue
            pk = pair_key(vault, ida, idb)
            row = conn.execute("SELECT verdict FROM pairs WHERE pair_key=?", (pk,)).fetchone()
            if row:
                continue
            conn.execute(
                "INSERT OR IGNORE INTO pairs (pair_key, vault, id_a, id_b, verdict, reason, checked_at, linked_at) "
                "VALUES (?,?,?,?,'linked','pre-existing (seeded from server)',?,?)",
                (pk, vault, ida, idb, time.time(), time.time()))
            seeded += 1
    conn.commit()
    return seeded


def flush_flagged(rest: RestClient, conn: sqlite3.Connection, vaults: list[str]) -> int:
    """--run only: write any pairs previously judged 'flagged' by a prior
    --dry-run pass."""
    written = 0
    placeholders = ",".join("?" * len(vaults)) if vaults else None
    q = "SELECT pair_key, vault, id_a, id_b FROM pairs WHERE verdict='flagged'"
    params: tuple = ()
    if placeholders:
        q += f" AND vault IN ({placeholders})"
        params = tuple(vaults)
    for row in conn.execute(q, params).fetchall():
        resp = rest.link(row["vault"], row["id_a"], row["id_b"])
        if resp is not None:
            conn.execute("UPDATE pairs SET verdict='linked', linked_at=? WHERE pair_key=?",
                         (time.time(), row["pair_key"]))
            written += 1
            log(f"  [{row['vault']}] flushed flagged pair {row['id_a']}<->{row['id_b']}")
        else:
            log(f"  [{row['vault']}] flush FAILED for {row['id_a']}<->{row['id_b']}")
        conn.commit()
    return written


def process_target(rest: RestClient, conn: sqlite3.Connection, lm: LMStudio, model_cfg: dict,
                    reasoning_mode: str, vault: str, target_id: str, pcfg: dict, dry_run: bool,
                    stats: dict, samples: dict) -> None:
    full = rest.get_engram(vault, target_id)
    if not full:
        log(f"  [{vault}] {target_id}: fetch failed, leaving unswept")
        return
    concept = full.get("concept", "")
    content = full.get("content", "")
    summary = full.get("summary", "")
    entities = full.get("entities") or []
    chash = content_hash(concept, content)

    prev = conn.execute("SELECT content_hash FROM sweep WHERE vault=? AND id=?", (vault, target_id)).fetchone()
    changed = bool(prev and prev["content_hash"] and prev["content_hash"] != chash)
    if changed:
        conn.execute("DELETE FROM pairs WHERE vault=? AND (id_a=? OR id_b=?)", (vault, target_id, target_id))
        conn.commit()
        stats["requeued_on_change"] += 1
        log(f"  [{vault}] {target_id}: content changed, cleared cached pairs")

    conn.execute(
        "UPDATE sweep SET concept=?, summary=?, content=?, entities=?, content_hash=?, swept_at=? "
        "WHERE vault=? AND id=?",
        (concept, summary, content, json.dumps(entities), chash, time.time(), vault, target_id))
    conn.commit()

    target = {"id": target_id, "concept": concept, "summary": summary, "content": content, "entities": entities}
    candidates, diag = gen_candidates(rest, conn, vault, target, pcfg["partners_max"], pcfg["partners_semantic"])
    stats["diag_entity_hits"] += diag["entity_hits"]
    stats["diag_semantic_hits"] += diag["semantic_hits"]

    fresh = []
    for c in candidates:
        pk = pair_key(vault, target_id, c["id"])
        row = conn.execute("SELECT verdict FROM pairs WHERE pair_key=?", (pk,)).fetchone()
        if row:
            continue  # already resolved (flagged/linked/rejected) — never re-judge
        fresh.append(c)
    if not fresh:
        return

    stats["targets_judged"] += 1
    for i in range(0, len(fresh), 8):
        batch = fresh[i:i + 8]
        flagged = judge_batch(lm, model_cfg["id"], model_cfg["max_tokens"], reasoning_mode, target, batch)
        if flagged is None:
            stats["errors"] += 1
            continue
        flagged_ids = {f["candidate"]["id"] for f in flagged}
        stats["pairs_judged"] += len(batch)
        for c in batch:
            pk = pair_key(vault, target_id, c["id"])
            if c["id"] in flagged_ids:
                reason = next(f["reason"] for f in flagged if f["candidate"]["id"] == c["id"])
                if dry_run:
                    conn.execute(
                        "INSERT OR REPLACE INTO pairs (pair_key, vault, id_a, id_b, verdict, reason, checked_at) "
                        "VALUES (?,?,?,?,'flagged',?,?)",
                        (pk, vault, target_id, c["id"], reason, time.time()))
                    stats["flagged"] += 1
                else:
                    resp = rest.link(vault, target_id, c["id"])
                    if resp is not None:
                        conn.execute(
                            "INSERT OR REPLACE INTO pairs (pair_key, vault, id_a, id_b, verdict, reason, checked_at, linked_at) "
                            "VALUES (?,?,?,?,'linked',?,?,?)",
                            (pk, vault, target_id, c["id"], reason, time.time(), time.time()))
                        stats["linked"] += 1
                        log(f"  [{vault}] LINKED {target_id} <-> {c['id']}: {reason}")
                    else:
                        stats["errors"] += 1
                if len(samples["flagged"]) < 12:
                    samples["flagged"].append({
                        "vault": vault, "target": target_id, "target_concept": concept,
                        "candidate": c["id"], "candidate_concept": c.get("concept", ""),
                        "reason": reason,
                    })
            else:
                conn.execute(
                    "INSERT OR REPLACE INTO pairs (pair_key, vault, id_a, id_b, verdict, reason, checked_at) "
                    "VALUES (?,?,?,?,'rejected','',?)",
                    (pk, vault, target_id, c["id"], time.time()))
                stats["rejected"] += 1
                if len(samples["rejected"]) < 6:
                    samples["rejected"].append({
                        "vault": vault, "target": target_id, "target_concept": concept,
                        "candidate": c["id"], "candidate_concept": c.get("concept", ""),
                    })
        conn.commit()


def run_pass(cfg: dict, pcfg: dict, rest: RestClient, lm: LMStudio, conn: sqlite3.Connection,
             vaults: list[str], limit: int, dry_run: bool) -> dict:
    model_cfg = cfg["models"][pcfg["model"]]
    reasoning_mode = pcfg.get("reasoning", "off")

    seeded = seed_pairs_from_server(rest, conn, vaults)
    log(f"seeded {seeded} pre-existing linked pair(s) from server")

    flushed = 0
    if not dry_run:
        flushed = flush_flagged(rest, conn, vaults)
        if flushed:
            log(f"flushed {flushed} previously-flagged pair(s) from an earlier --dry-run")

    for vault in vaults:
        added = discover_vault(rest, conn, vault, pcfg["discovery_page_size"], pcfg["discovery_max_pages_per_vault"])
        if added:
            log(f"[{vault}] discovered {added} new engram(s)")

    stats = {
        "targets_judged": 0, "pairs_judged": 0, "flagged": 0, "linked": 0, "rejected": 0,
        "errors": 0, "requeued_on_change": 0, "diag_entity_hits": 0, "diag_semantic_hits": 0,
        "flushed": flushed, "seeded": seeded, "stopped_early": None,
    }
    samples = {"flagged": [], "rejected": []}

    unlimited = limit <= 0
    CHUNK = 25  # internal per-vault refill granularity for the round-robin, not a total cap
    model_id = model_cfg["id"]

    def model_still_up() -> bool:
        """Jake's chosen kill switch is stopping LM Studio outright — checked
        before every target so a long unlimited sweep stops within one
        target's worth of latency instead of erroring out. Nothing already
        judged is lost: swept_at is only set after a target finishes, so an
        interrupted sweep resumes exactly where it left off next run."""
        ready, reason = lm.model_ready(model_id)
        if not ready:
            log(f"model unavailable mid-sweep ({reason}) — stopping gracefully, state is resumable")
        return ready

    processed = 0
    queues: dict[str, list[str]] = {v: [] for v in vaults}
    active = list(vaults)
    stopped_early = False

    # Phase A: drain every vault's unswept backlog, round-robin so a huge
    # single-vault backlog (agent-memory) can't starve smaller project
    # vaults within this run.
    while active:
        if not unlimited and processed >= limit:
            break
        progressed = False
        for vault in list(active):
            if not unlimited and processed >= limit:
                break
            if not queues[vault]:
                queues[vault] = select_unswept_chunk(conn, vault, CHUNK)
            if not queues[vault]:
                active.remove(vault)
                continue
            if not model_still_up():
                stopped_early = True
                break
            target_id = queues[vault].pop(0)
            process_target(rest, conn, lm, model_cfg, reasoning_mode, vault, target_id, pcfg, dry_run, stats, samples)
            processed += 1
            progressed = True
        if stopped_early or not progressed:
            break

    # Phase B: small, quota-bounded recheck pass (content-change detection)
    # — only if the backlog drain wasn't cut short by the kill switch or the
    # (optional, testing-only) --limit.
    if not stopped_early and (unlimited or processed < limit):
        for vault in vaults:
            if not unlimited and processed >= limit:
                break
            for target_id in select_recheck_chunk(conn, vault, pcfg["recheck_quota_per_vault"]):
                if not unlimited and processed >= limit:
                    break
                if not model_still_up():
                    stopped_early = True
                    break
                process_target(rest, conn, lm, model_cfg, reasoning_mode, vault, target_id, pcfg, dry_run, stats, samples)
                processed += 1
            if stopped_early:
                break

    stats["processed"] = processed
    stats["stopped_early"] = stopped_early
    return {"stats": stats, "samples": samples}


# ─── Status ──────────────────────────────────────────────────────────────────

def print_status(conn: sqlite3.Connection) -> None:
    print("sweep coverage by vault:")
    for row in conn.execute(
            "SELECT vault, COUNT(*) AS total, SUM(CASE WHEN swept_at IS NULL THEN 1 ELSE 0 END) AS unswept "
            "FROM sweep GROUP BY vault ORDER BY total DESC"):
        cur = conn.execute("SELECT backlog_done FROM discovery_cursor WHERE vault=?", (row["vault"],)).fetchone()
        done = bool(cur and cur["backlog_done"])
        print(f"  {row['vault']}: {row['total']} known, {row['unswept']} unswept, "
              f"backlog_discovery={'complete' if done else 'in progress'}")
    print("\npairs by vault/verdict:")
    for row in conn.execute(
            "SELECT vault, verdict, COUNT(*) AS n FROM pairs GROUP BY vault, verdict ORDER BY vault, verdict"):
        print(f"  {row['vault']}: {row['verdict']}={row['n']}")


# ─── Entry ─────────────────────────────────────────────────────────────────

def main():
    cfg = load_config()
    pcfg = contradictor_cfg(cfg)
    p = argparse.ArgumentParser(description="muninn-contradictor: LLM contradiction-detection worker")
    p.add_argument("--dry-run", action="store_true", help="judge and print, zero writes")
    p.add_argument("--run", action="store_true", help="judge and write contradicts links")
    p.add_argument("--vault", help="restrict to a single vault")
    p.add_argument("--limit", type=int, default=pcfg["sweep_batch"],
                    help="max sweep targets this invocation (0/unset = unlimited, sweeps the entire "
                         "unswept backlog to completion — use a small value for testing)")
    p.add_argument("--status", action="store_true", help="show queue status and exit")
    p.add_argument("--fast", action="store_true", help="use the fast model instead of default")
    args = p.parse_args()

    conn = db_connect()

    if args.status:
        print_status(conn)
        return

    if not args.dry_run and not args.run:
        print("specify --dry-run or --run")
        sys.exit(1)
    if args.dry_run and args.run:
        print("--dry-run and --run are mutually exclusive")
        sys.exit(1)

    if "fast" in cfg.get("models", {}):
        pcfg["model"] = "fast" if args.fast else pcfg["model"]
    model_cfg = cfg["models"][pcfg["model"]]
    lm = LMStudio(cfg["lmstudio"])

    # exit 0 when the model isn't loaded — mirrors enricher/promoter daemon
    # semantics so a systemd timer never reports a spurious failure.
    ready, reason = lm.model_ready(model_cfg["id"])
    if not ready:
        log(f"skip: {reason}")
        print(f"model not ready: {reason}")
        sys.exit(0)

    ok, reasoning = lm.probe_thinking_off(model_cfg["id"])
    if reasoning < 0:
        print("⚠ probe failed — is LM Studio reachable? Proceeding anyway (quality unverified).")
    elif not ok:
        print(f"✗ requesting reasoning=off used {reasoning} reasoning tokens — native API is not honoring the per-request override.")
        sys.exit(1)

    reasoning_mode = pcfg.get("reasoning", "off")
    allowed = lm.reasoning_allowed_options(model_cfg["id"])
    if allowed and reasoning_mode not in allowed:
        print(f"✗ contradictor.reasoning={reasoning_mode!r} not in {model_cfg['id']}'s allowed_options {allowed}")
        sys.exit(1)

    endpoint, api_key = cfg["endpoint"], cfg["apply_api_key"]
    rest = RestClient(endpoint, api_key, pace_ms=pcfg["pace_ms"])

    vaults = [args.vault] if args.vault else rest.discover_vaults()
    if not vaults:
        print("no vaults reachable")
        return
    log(f"sweeping {len(vaults)} vault(s): {vaults} (model={model_cfg['id']}, dry_run={args.dry_run})")

    result = run_pass(cfg, pcfg, rest, lm, conn, vaults, args.limit, dry_run=args.dry_run)

    s = result["stats"]
    print(f"\n{'DRY RUN — zero remote writes' if args.dry_run else 'RUN'}"
          f"{'  [STOPPED EARLY: model became unavailable — state is resumable]' if s['stopped_early'] else ''}")
    print(f"seeded={s['seeded']} flushed={s['flushed']} processed(targets)={s['processed']} "
          f"judged(targets)={s['targets_judged']} pairs_judged={s['pairs_judged']}")
    print(f"flagged={s['flagged']} linked={s['linked']} rejected={s['rejected']} errors={s['errors']} "
          f"requeued_on_change={s['requeued_on_change']}")
    print(f"candidate diag: entity_hits={s['diag_entity_hits']} semantic_hits={s['diag_semantic_hits']} "
          f"lexical=skipped(no FTS/search REST route)")

    if result["samples"]["flagged"]:
        print("\n--- FLAGGED contradictions ---")
        for smp in result["samples"]["flagged"]:
            print(f"\n[{smp['vault']}] {smp['target']} ({smp['target_concept']}) <-> "
                  f"{smp['candidate']} ({smp['candidate_concept']})")
            print(f"  reason: {smp['reason']}")
    if result["samples"]["rejected"]:
        print("\n--- REJECTED (non-contradictory) samples ---")
        for smp in result["samples"]["rejected"]:
            print(f"\n[{smp['vault']}] {smp['target']} ({smp['target_concept']}) vs "
                  f"{smp['candidate']} ({smp['candidate_concept']})")


if __name__ == "__main__":
    main()
